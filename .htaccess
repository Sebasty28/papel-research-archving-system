# Prevent public access to sensitive files
<FilesMatch "^\.env|.*\.json|.*\.md|.*\.log$">
    # Apache 2.4 and 2.2 spell this differently, and the two must not be mixed in
    # one block. Only 2.2 syntax was here, which works locally because XAMPP
    # loads mod_access_compat; a host running 2.4 without it ignores the whole
    # rule in silence and serves .env, database password and API keys included.
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

<IfModule mod_headers.c>
    # Anti-clickjacking fallback (ID-003)
    Header set X-Frame-Options "SAMEORIGIN"
    
    # MIME type sniffing prevention
    Header set X-Content-Type-Options "nosniff"
    
    # Referrer policy
    Header set Referrer-Policy "strict-origin-when-cross-origin"
    
    # Restrict sensitive browser features
    Header set Permissions-Policy "geolocation=(), microphone=(), camera=()"
    
    # Deny cross-origin reads — remove any permissive CORS headers (ID-005)
    Header always unset Access-Control-Allow-Origin
    Header always unset Access-Control-Allow-Methods
    Header always unset Access-Control-Allow-Headers
    Header always unset Access-Control-Allow-Credentials
    
    # HSTS - Strict Transport Security (ID-018)
    Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
    
    # Remove Server and X-Powered-By headers (ID-016, ID-017)
    Header always unset X-Powered-By
    Header unset X-Powered-By
    Header always unset Server
    Header unset Server

    # Remove CSP Report-Only header if accidentally set (ID-021)
    Header always unset Content-Security-Policy-Report-Only
</IfModule>

# Prevent caching of PHP responses containing sensitive/user data (ID-027, ID-028)
<FilesMatch "\.php$">
    <IfModule mod_headers.c>
        Header always set Cache-Control "no-store, no-cache, must-revalidate, private"
        Header always set Pragma "no-cache"
        Header always set Expires "0"
    </IfModule>
</FilesMatch>

# Disable Server Signature (ID-015)
ServerSignature Off

# Nothing below is part of the running site, and a deploy that forgets to
# exclude one of them should not make it reachable. .git in particular would
# hand over the whole history, .env.example and all, at /.git/config.
# reset_system_data.php empties the system; it is guarded by a role check and
# a token, and it still has no business answering a request on a live server.
# Nothing in the app links into these folders, so denying them costs nothing.
#
# RewriteRule, not RedirectMatch, because a RedirectMatch pattern is matched
# against the whole URL path: "^/scripts/" would fire on a server where the
# site is the domain root and quietly do nothing here, where it is served
# from /capstone/. A RewriteRule in .htaccess is matched relative to this
# folder, so one rule covers both. The RedirectMatch lines after it are the
# fallback for a server without mod_rewrite, where they are better than
# nothing even though they only cover the domain root case.
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteRule (^|/)\.git(/|$)                             - [R=404,L]
    RewriteRule ^(scripts|tests|docs|database|backups)(/|$) - [R=404,L]
    RewriteRule ^reset_system_data\.php$                    - [R=404,L]
</IfModule>
<IfModule !mod_rewrite.c>
    RedirectMatch 404 /\.git(/|$)
    RedirectMatch 404 ^/(scripts|tests|docs|database|backups)(/|$)
    RedirectMatch 404 ^/reset_system_data\.php$
</IfModule>

# No directory listings anywhere.
Options -Indexes

<IfModule mod_php.c>
    # Try to disable expose_php via php_flag if permitted
    php_flag expose_php Off
</IfModule>