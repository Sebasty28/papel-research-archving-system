# Prevent public access to sensitive files
<FilesMatch "^\.env|.*\.json|.*\.md|.*\.log$">
    # Apache 2.4 and 2.2 spell this differently, and the two must not be mixed in
    # one block. Only 2.2 syntax was here, which works locally because XAMPP
    # loads mod_access_compat; a host running 2.4 without it ignores the whole
    # rule in silence and serves .env, database password and API keys included.
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

<IfModule mod_headers.c>
    # These four go on every response, redirects and error pages included
    # (ID-003, ID-020). "Header set" writes only to the table Apache sends with a
    # success, so a 301, a 404 or a 500 went out with HSTS and none of these:
    # the ZAP scan of 2026-11-24 caught it on the /archive/index.php redirect.
    # "always" is the other table, and PHP's own header() calls land in the
    # first one, so each "always set" is paired with a plain "unset" that
    # clears a copy PHP may have sent (app/paper_file.php sends nosniff).
    # Without the pair that endpoint would send the header twice, which ZAP
    # reports as a fault of its own. The same pair as X-Powered-By below.

    # Anti-clickjacking fallback (ID-003)
    Header unset X-Frame-Options
    Header always set X-Frame-Options "SAMEORIGIN"

    # MIME type sniffing prevention
    Header unset X-Content-Type-Options
    Header always set X-Content-Type-Options "nosniff"

    # Referrer policy
    Header unset Referrer-Policy
    Header always set Referrer-Policy "strict-origin-when-cross-origin"

    # Restrict sensitive browser features
    Header unset Permissions-Policy
    Header always set Permissions-Policy "geolocation=(), microphone=(), camera=()"
    
    # Deny cross-origin reads — remove any permissive CORS headers (ID-005)
    Header always unset Access-Control-Allow-Origin
    Header always unset Access-Control-Allow-Methods
    Header always unset Access-Control-Allow-Headers
    Header always unset Access-Control-Allow-Credentials
    
    # HSTS - Strict Transport Security (ID-018)
    Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
    
    # Remove Server and X-Powered-By headers (ID-016, ID-017)
    Header always unset X-Powered-By
    Header unset X-Powered-By
    Header always unset Server
    Header unset Server

    # Remove CSP Report-Only header if accidentally set (ID-021)
    Header always unset Content-Security-Policy-Report-Only
</IfModule>

# Prevent caching of PHP responses containing sensitive/user data (ID-027, ID-028)
<FilesMatch "\.php$">
    <IfModule mod_headers.c>
        Header always set Cache-Control "no-store, no-cache, must-revalidate, private"
        Header always set Pragma "no-cache"
        Header always set Expires "0"
    </IfModule>
</FilesMatch>

# Cache source assets briefly, and keep versioned assets for a year.
# asset_url() changes ?v= whenever an asset is edited, so repeat visits can
# reuse the unchanged stylesheet or script without downloading it again.
# The stamp is a short hex hash, not the file's raw mtime (ID-019: ZAP read
# every ?v= as a disclosed Unix timestamp), so this has to accept hex. Digits
# are hex too, so a page cached with an old numeric stamp still matches.
<FilesMatch "\.(css|m?js|woff2?|png|jpe?g|gif|svg|webp|ico)$">
    <IfModule mod_headers.c>
        Header set Cache-Control "public, max-age=3600"
        Header set Cache-Control "public, max-age=31536000, immutable" "expr=%{QUERY_STRING} =~ /(^|&)v=[0-9a-f]+(&|$)/"
    </IfModule>
</FilesMatch>

# A host whose mime.types predates woff2 serves the fonts with no
# Content-Type at all, which production did (ID-032). XAMPP already knows
# the type; saying so here makes every copy agree.
<IfModule mod_mime.c>
    AddType font/woff2 .woff2
    AddType font/woff  .woff
    # PDF.js is an ES module (.mjs) from v4 onwards. A module is fetched with a
    # strict MIME check: a host whose mime.types predates .mjs serves it as
    # text/plain, the browser refuses it outright, and every PDF on the site
    # stops opening. XAMPP already knows the type; saying so here makes the
    # deployed copies agree.
    AddType text/javascript .mjs
</IfModule>

# Disable Server Signature (ID-015)
ServerSignature Off

# Nothing below is part of the running site, and a deploy that forgets to
# exclude one of them should not make it reachable. .git in particular would
# hand over the whole history, .env.example and all, at /.git/config.
# reset_system_data.php empties the system; it is guarded by a role check and
# a token, and it still has no business answering a request on a live server.
# Nothing in the app links into these folders, so denying them costs nothing.
#
# RewriteRule, not RedirectMatch, because a RedirectMatch pattern is matched
# against the whole URL path: "^/scripts/" would fire on a server where the
# site is the domain root and quietly do nothing here, where it is served
# from /capstone/. A RewriteRule in .htaccess is matched relative to this
# folder, so one rule covers both. The RedirectMatch lines after it are the
# fallback for a server without mod_rewrite, where they are better than
# nothing even though they only cover the domain root case.
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteRule (^|/)\.git(/|$)                             - [R=404,L]
    RewriteRule ^(scripts|tests|docs|database|backups)(/|$) - [R=404,L]
    RewriteRule ^reset_system_data(?:\.php)?$                - [R=404,L]

    # Keep browser page addresses free of .php. THE_REQUEST makes these rules
    # apply only to an explicit URL, never to the internal rewrite below.
    # Limit redirects to HTML navigation so PHP endpoints and file fetches keep
    # their original URLs and request bodies. Existing query strings survive.
    RewriteCond %{REQUEST_METHOD} ^(GET|HEAD)$
    RewriteCond %{HTTP:Accept} text/html [NC]
    RewriteCond %{THE_REQUEST} \.php(?:\?|\s) [NC]
    RewriteCond %{REQUEST_URI} ^(.*/)index\.php$ [NC]
    RewriteRule ^(.*/)?index\.php$ %1 [R=301,L,NE]

    RewriteCond %{REQUEST_METHOD} ^(GET|HEAD)$
    RewriteCond %{HTTP:Accept} text/html [NC]
    RewriteCond %{THE_REQUEST} \.php(?:\?|\s) [NC]
    RewriteCond %{REQUEST_URI} ^(.+)\.php$ [NC]
    RewriteRule ^(.+)\.php$ %1 [R=301,L,NE]

    # Serve clean page URLs without renaming the PHP files or their links.
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_FILENAME}.php -f
    RewriteRule ^(.+[^/])$ $1.php [L]
</IfModule>
<IfModule !mod_rewrite.c>
    RedirectMatch 404 /\.git(/|$)
    RedirectMatch 404 ^/(scripts|tests|docs|database|backups)(/|$)
    RedirectMatch 404 ^/reset_system_data(?:\.php)?$
</IfModule>

# No directory listings anywhere.
Options -Indexes -MultiViews

<IfModule mod_php.c>
    # Try to disable expose_php via php_flag if permitted
    php_flag expose_php Off
</IfModule>
