# PAPEL — settings template
#
# Copy this file to .env and fill in the real values:
#
#     copy .env.example .env        (Windows)
#     cp .env.example .env          (Mac/Linux)
#
# .env is listed in .gitignore and must never be committed — it holds live
# passwords and API keys. This file is the opposite: it is committed on purpose,
# so anyone setting the project up knows which settings exist. Keep the
# placeholders here; put the real values only in your own .env.
#
# Ask Seb or Rayver for the current values. Send them privately — a chat
# message, not a pull request.


# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------
APP_NAME=PAPEL
# No trailing slash. Match the folder name under htdocs.
BASE_URL=http://localhost/capstone


# ---------------------------------------------------------------------------
# Database
#
# Create the database in phpMyAdmin first, then import the .sql you were given.
# On a default XAMPP install the user is root with an empty password.
# ---------------------------------------------------------------------------
DB_HOST=localhost
DB_NAME=capstone_db
DB_USER=root
DB_PASS=
DB_CHARSET=utf8mb4


# ---------------------------------------------------------------------------
# Security
#
# CSRF_KEY signs the tokens that protect every form. Use a long random string —
# any password generator will do. Do not leave it as the placeholder.
# COOKIE_SECURE stays false on localhost (http) and becomes true on https.
# ---------------------------------------------------------------------------
CSRF_KEY=change_this_to_a_long_random_string
COOKIE_SECURE=false


# ---------------------------------------------------------------------------
# Mail
#
# The account PAPEL sends from. SMTP_PASS is a Gmail *app password* — a 16
# character code from the Google account's security page — not the password you
# log in with. Leave these blank and email is simply skipped.
# ---------------------------------------------------------------------------
SMTP_HOST=smtp.gmail.com
SMTP_USER=
SMTP_PASS=
SMTP_PORT=587

# Where the contact form delivers, and the address shown on the support page.
SUPPORT_EMAIL=clarionlessonvewsystem@gmail.com


# ---------------------------------------------------------------------------
# Google Drive
#
# Uploaded papers are stored in Drive. From the Google Cloud console, create an
# OAuth client and paste its ID and secret here. Leave the folder ID blank to
# upload to the Drive root, or set it from the Storage Folder page in the app.
# ---------------------------------------------------------------------------
GDRIVE_CLIENT_ID=
GDRIVE_CLIENT_SECRET=
GDRIVE_REDIRECT_URI=http://localhost/capstone/config/gdrive_callback.php
GDRIVE_PARENT_FOLDER_ID=


# ---------------------------------------------------------------------------
# Groq AI
#
# Used for the paper summaries, the IMRaD check and the chatbots. Free keys come
# from console.groq.com. One key works for everything — the separate keys below
# exist only so one busy feature cannot exhaust the rate limit for the others.
# Any left blank fall back to GROQ_API_KEY.
# ---------------------------------------------------------------------------
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-120b

GROQ_API_KEY_UPLOAD=
GROQ_API_KEY_UPLOAD_2=
GROQ_API_KEY_SUPERADMIN=
GROQ_API_KEY_ADMIN=
GROQ_API_KEY_FACULTY=
GROQ_API_KEY_STUDENT=
GROQ_API_KEY_CHATBOT=
GROQ_API_KEY_CHATBOT_2=
