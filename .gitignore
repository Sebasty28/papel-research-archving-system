# Sensitive files
.env
google_credentials.json
gdrive_token.json
cacert.pem
# The database CA a hosted provider hands you. Not a secret in the way a
# password is, but it belongs to one service and one account, so it stays out.
config/certs/
*.pem
# Google hands these out with a name like
# client_secret_<id>.apps.googleusercontent.com.json — one was sitting in the
# project root, untracked but unignored, one "git add -A" away from being public.
client_secret*.json
*.apps.googleusercontent.com.json

# Build artefacts
composer.phar

# Uploads — students' own work, and their consent and copyright forms.
# These patterns only matched a top-level uploads/ folder, but the files are
# actually written to app/student/uploads/, so 119 of them were being tracked.
# The leading ** matches the folder wherever it is.
**/uploads/research/**
**/uploads/supporting_docs/**
**/uploads/drafts/**
**/uploads/temp/**
# Pictures pasted into the written sections. Students' own work as well.
**/uploads/section_images/**
!**/uploads/.htaccess
!**/uploads/index.php

# Runtime files
guest_ips.txt

# Composer
vendor/

# Logs
*.log
notifications/notifications.log

# IDE
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Local .env backups (they contain live API keys)
.env.bak-*

# Local database backups
backups/

# Python bytecode from the field-guide build and the test suite
__pycache__/
*.pyc

# One-off QA runs under tests/. These are scratch: each is pinned to the
# disposable database and dated output folder of the run it was written for
# (papel_qa_20261123, ~/Downloads/PAPEL QA 2026-11-23), so a later reader
# cannot run one and would be misled by it. The durable suites are the
# m*.py files, harness.py, fixtures.py and the _*_unit.php checks, which are
# all tracked. Kept on the dev box, out of the repository.
tests/qa_tracker_*.py
tests/qa_staging_public.py
tests/qa_remaining_inventory.json
tests/_expiry_probe.php
tests/_mail_probe.php
tests/_qa_drive_probe.php
